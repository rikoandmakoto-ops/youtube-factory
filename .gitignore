# ===== OS / Editor =====
.DS_Store
*.swp
.idea/
.vscode/

# ===== Secrets =====
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local
# OAuth トークンDB（Fernet 暗号化済みだが秘密情報。絶対にコミットしない）
backend/pipeline/credentials/oauth.db
*.db
# バックエンド API の自前キー。ローカルには残すが追跡しない。
backend/pipeline/credentials/api_key.txt
# DB やコンフィグの退避コピー。拡張子が .db で終わらないので上の *.db を素通りする。
*.bak_*
*.before_*

# ===== Node / Next.js =====
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/coverage
.pnp
.pnp.*

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ===== Vercel =====
.vercel

# ===== Claude Code local =====
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# ===== Runtime data / generated artifacts =====
jobs/
logs/
!frontend/src/app/logs/
!frontend/src/app/api/logs/
data/*.db
data/analytics/*.db
data/samples/
data/thumbnails/
data/cache/
data/api_usage.jsonl
data/job_queue.json
backend/static/
# エージェント常駐時に生成されるチャンネル別ランタイム状態
data/channels/*/
# ショート単体実行などのアドホック結果ダンプ
backend/short_only_results_*.json
# PDCA スクリプトが書き換え前に残す使い捨てスナップショット。
# 元ファイル（data/channels/*.json 等）は追跡しているので履歴はそちらで追える。
data/**/*.bak_*
# A/B テストの実行ログ。analytics 同期のたびに全ファイルの updated_at だけが
# 書き換わり、毎日 500 ファイル規模の無意味な差分になる。集計結果は
# data/reports/ と data/analytics/analytics.db に残るのでこちらは追跡しない。
data/ab_tests/
# 立ち絵などの手動退避コピー（1回で数十MB）。原本は assets/characters/ 直下。
assets/**/_backup_*/

# ===== 使い捨ての検証スクリプト =====
# 調査中にその場で書いて捨てる Node スクリプト。再実行する価値のあるものは
# scripts/ に名前を付けて置くこと。
*.audit.mjs
.e2e-jobs.mjs

# ===== Large root-level samples / temp media =====
*.b64
*.mp4
*.wav
*.mp3
sample_*.png
wrinkly_fingers_*.png
thumbnail_selfcontained.html
# 動画生成の最終成果物置き場（1本数十MB。GitHubには載せない）
output/

# ===== Misc =====
*.pem
# LibreOffice / Excel のロックファイル
.~lock.*#
# 疎通確認用の使い捨てファイル
_sync_test.txt

# ===== ChatGPT 画像ブリッジ（docs/CHATGPT_IMAGE_BRIDGE.md）=====
# キューは実行時の状態なので載せない。ただし threads.json（チャンネル ↔ ChatGPT
# スレッドの対応）は設定なので追跡する。
data/image_requests/*
!data/image_requests/threads.json
