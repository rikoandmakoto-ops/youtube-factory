#!/bin/bash
# =====================================================================
#  YouTube Factory 指揮者 — 2026-09-20
#
#  ★ 今日は「実行が必要な作業」はほぼありません。
#    バックエンドの再起動も、手動トリガーも不要です。
#    お願いは pokemon-lab の OAuth 再認可の1件だけです。
#
#  ═══════════════════════════════════════════════════════════════════
#  ★★★ 今日の発見：壊れていたのは冒頭ではなく「末尾」でした ★★★
#  ═══════════════════════════════════════════════════════════════════
#
#  09-07 からずっと「離脱は再生13〜22%地点」として2行目の台本を直し続けて
#  きましたが、維持曲線を再生位置ごとに分解したところ前提が違っていました。
#
#    ゆっくり系5ch・視聴維持率(audience_watch_ratio)の中央値
#      再生位置    0%    10%    15%    20%    50%    80%   100%
#      08-18まで 116.7  111.1  107.2   90.8   48.2   33.8   17.2
#      09-12以降 109.9  107.7   99.6   74.7   31.8   19.2    9.8
#
#    → 0〜10% は前後でほぼ同じ。**冒頭フックは壊れていません。**
#      差は15%以降で開き、末尾ほど広がって、100%地点でほぼ半減します。
#
#  さらに「完走率」と「ループ率」が、5chすべて 08-19 に同時に落ちて
#  そのまま戻っていません。
#
#      ch              ループ率       完走率        再生中央値
#      daily-science  114.5→110.0   15.6→12.1    1,076→872
#      scp-lab        113.5→106.4   16.0→ 7.5    1,098→909
#      yokai-watch    119.6→110.7   20.7→11.7    1,492→981
#      2ch-matome     118.3→109.4   19.9→ 9.4    1,236→873
#      pokemon-lab    120.4→107.1   22.1→ 8.6    1,588→(停止)
#
#  5chが同じ日に同じ向きに落ちる、というのは各chの台本を直した結果では
#  説明がつきません。全ch一斉に入った変更を疑うべきです。
#
#  ─────────────────────────────────────────────────────────────────
#  そこで 08-19 のコミットを見ると、動画そのものを変えたものが3本あり、
#  うち2本は既に撤回済みでした。残っていたのが これです:
#
#    ddff8f8  short_endcard.py を新設
#             → 全6chの動画の末尾に「無音の静止画カード」を1.6〜1.8秒
#               焼き込む機能。32日間、一度も検証されていませんでした。
#
#  Shorts はループ再生されます。ループして冒頭へ戻る直前に、無音の
#  静止画で「終わりました」という合図を1.6秒置いている状態です。
#  壊れている指標（完走・ループ）と、変更が入った位置（末尾）が
#  ぴったり一致しています。
#
#  しかも、このカードは肝心の登録を稼いでいませんでした。
#    登録/千再生(6ch合計): 導入前 0.512 → 0.510 → 0.730 → 0.436
#  導入による跳ねがありません。登録を稼がずにリーチだけ削っている、
#  という形になっています。
#
#  ─────────────────────────────────────────────────────────────────
#  ★ 本日行った変更（すでに適用済み・作業不要）
#  ─────────────────────────────────────────────────────────────────
#
#    エンドカードのA/Bテスト 1件だけです。
#
#      カードOFF : daily-science / yokai-watch / 2ch-matome
#      対照(ON)  : scp-lab / company-facts     ← 09-27まで触りません
#      除外      : pokemon-lab（OAuth失効中で条件が揃わないため）
#
#    判定は 2026-09-27。完走率が 11.5% → 16%以上に戻れば確定、
#    戻らなければカードを元に戻します。
#
#    ※ バックエンドの再起動は不要です。チャンネル設定は生成のたびに
#      ディスクから読み直される実装（load_channel にキャッシュなし）
#      なので、本日 11:15 の yokai-watch から新設定で作られます。
#
#    ※ 手動トリガーも不要です。APScheduler が本日分14枠を予約済みで、
#      09-13〜09-19 は毎日きっちり13〜14本公開できています。
#      手で叩くと重複投稿と連投ガードの空振りになるだけです。
#
#  ═══════════════════════════════════════════════════════════════════
#  ★ ザキ様にお願いしたいこと（1件だけ・11日放置）
#  ═══════════════════════════════════════════════════════════════════
#
#  【pokemon-lab の OAuth 再認可】
#
#    09-10 07:43 を最後にトークンが更新できず、09-14 に autopilot が
#    自動で無効化されました。ログには毎日こう出ています:
#      invalid_grant: Token has been expired or revoked.
#
#    pokemon-lab は成熟動画の 40%（25本中10本）が1,200再生を超えていて、
#    6ch の中でいちばん天井が高いチャンネルです。
#    止めている損がいちばん大きいので、お手すきのときにお願いします。
#
#    ↓ このスクリプトを実行すると、再認可用のURLが開きます。
#
#  ─────────────────────────────────────────────────────────────────
#  サムネ403 は 09-19 の実測どおり優先度を下げたままです（急ぎません）。
#  再生の99.5%はShortsフィード由来で、サムネの効きうる上限は0.48%でした。
#  （company-facts で新たに「サムネ2MB超」エラーも出ていますが同じ理由で保留）
#  =====================================================================

set -u
cd "$(dirname "$0")"

echo "======================================================"
echo " YouTube Factory — 2026-09-20"
echo "======================================================"
echo

# --- 1. バックエンドの生存確認 -------------------------------------
echo "[1/3] バックエンドの生存確認..."
if curl -s -m 5 -o /dev/null http://localhost:8000/api/health; then
  echo "      OK — 起動しています（再起動は不要です）"
else
  echo "      応答がありません。restart_backend.command を実行してください。"
fi
echo

# --- 2. 本日のエンドカード設定を確認 -------------------------------
echo "[2/3] エンドカードA/Bの設定を確認..."
python3 - <<'PY'
import json, os
off  = ["daily-science", "yokai-watch", "2ch-matome"]
ctrl = ["scp-lab", "company-facts"]
for ch in off + ctrl:
    p = os.path.join("data", "channels", f"{ch}.json")
    d = json.load(open(p, encoding="utf-8"))
    ec = (d.get("defaults") or {}).get("short_endcard") or {}
    arm = "OFF(検証群)" if ch in off else "ON (対照群)"
    ok = (ec.get("enabled") is False) if ch in off else (ec.get("enabled") is not False)
    print(f"      {ch:15s} {arm:12s} enabled={str(ec.get('enabled')):5s} {'✓' if ok else '✗ 想定と違います'}")
PY
echo

# --- 3. pokemon-lab の OAuth 再認可 --------------------------------
echo "[3/3] pokemon-lab の OAuth 再認可"
echo "      ブラウザが開きます。pokemon-lab のチャンネルを持つ Google"
echo "      アカウントでログインして、権限を許可してください。"
echo
read -r -p "      いま再認可しますか？ [y/N]: " ans
if [[ "${ans:-N}" =~ ^[Yy]$ ]]; then
  open "http://localhost:8000/api/youtube/oauth/start?channel_id=pokemon-lab" \
    || echo "      ブラウザを開けませんでした。上記URLを直接開いてください。"
  echo
  echo "      許可が終わったら、以下で autopilot を再開してください:"
  echo "        curl -X POST http://localhost:8000/api/channels/pokemon-lab/autopilot/enable"
else
  echo "      スキップしました。お手すきのときにお願いします。"
fi

echo
echo "======================================================"
echo " 本日のレポート: reports/youtube_analysis_20260920.xlsx"
echo " 詳細メモ      : MEMORY_UPDATE_20260920.md"
echo "======================================================"
